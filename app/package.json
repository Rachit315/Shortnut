{
  "name": "shortnut",
  "productName": "Shortnut",
  "version": "1.0.1",
  "description": "Convert, compress and edit any file with just drag + Shift.",
  "main": "src/main/main.js",
  "author": "Shortnut contributors",
  "license": "MIT",
  "homepage": "https://shortnut.app",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/make-icons.js",
    "test": "electron test/run-tests.js",
    "shots": "electron . --screenshots",
    "pack": "electron-builder --win --dir",
    "dist": "npm run icons && electron-builder --win --x64 && node scripts/publish-to-website.js"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "koffi": "^3.3.3",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.shortnut.desktop",
    "productName": "Shortnut",
    "copyright": "Copyright © 2026 Shortnut contributors. MIT License.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!node_modules/pdfjs-dist/**/*",
      "!node_modules/@napi-rs/**/*",
      "!node_modules/pdf-lib/{dist,es,src,ts3.4}/**/*",
      "!node_modules/docx/dist/*.{mjs,iife.js,d.ts,d.cts}",
      "!node_modules/libheif-js/libheif/**/*",
      "!node_modules/**/{test,tests,__tests__,docs,doc,example,examples}/**"
    ],
    "extraResources": [
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Shortnut-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shortnut",
      "runAfterFinish": true,
      "license": "LICENSE",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
