; Extra NSIS steps for Shortnut.
; On uninstall: remove the per-user Explorer "Convert with Shortnut" entries and the startup entry.

!macro RemoveShortnutVerb EXT
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.${EXT}\shell\Shortnut"
!macroend

!macro customUnInstall
  !insertmacro RemoveShortnutVerb "jpg"
  !insertmacro RemoveShortnutVerb "jpeg"
  !insertmacro RemoveShortnutVerb "jfif"
  !insertmacro RemoveShortnutVerb "png"
  !insertmacro RemoveShortnutVerb "webp"
  !insertmacro RemoveShortnutVerb "avif"
  !insertmacro RemoveShortnutVerb "gif"
  !insertmacro RemoveShortnutVerb "tif"
  !insertmacro RemoveShortnutVerb "tiff"
  !insertmacro RemoveShortnutVerb "bmp"
  !insertmacro RemoveShortnutVerb "heic"
  !insertmacro RemoveShortnutVerb "heif"
  !insertmacro RemoveShortnutVerb "svg"
  !insertmacro RemoveShortnutVerb "ico"
  !insertmacro RemoveShortnutVerb "pdf"
  !insertmacro RemoveShortnutVerb "docx"
  !insertmacro RemoveShortnutVerb "txt"
  !insertmacro RemoveShortnutVerb "md"
  !insertmacro RemoveShortnutVerb "markdown"
  !insertmacro RemoveShortnutVerb "html"
  !insertmacro RemoveShortnutVerb "htm"
  !insertmacro RemoveShortnutVerb "csv"
  !insertmacro RemoveShortnutVerb "json"
  !insertmacro RemoveShortnutVerb "mp4"
  !insertmacro RemoveShortnutVerb "mov"
  !insertmacro RemoveShortnutVerb "mkv"
  !insertmacro RemoveShortnutVerb "webm"
  !insertmacro RemoveShortnutVerb "avi"
  !insertmacro RemoveShortnutVerb "m4v"
  !insertmacro RemoveShortnutVerb "wmv"
  !insertmacro RemoveShortnutVerb "flv"
  !insertmacro RemoveShortnutVerb "3gp"
  !insertmacro RemoveShortnutVerb "mpg"
  !insertmacro RemoveShortnutVerb "mpeg"
  !insertmacro RemoveShortnutVerb "ts"
  !insertmacro RemoveShortnutVerb "mp3"
  !insertmacro RemoveShortnutVerb "wav"
  !insertmacro RemoveShortnutVerb "m4a"
  !insertmacro RemoveShortnutVerb "aac"
  !insertmacro RemoveShortnutVerb "ogg"
  !insertmacro RemoveShortnutVerb "oga"
  !insertmacro RemoveShortnutVerb "flac"
  !insertmacro RemoveShortnutVerb "opus"
  !insertmacro RemoveShortnutVerb "wma"
  !insertmacro RemoveShortnutVerb "aiff"
  !insertmacro RemoveShortnutVerb "aif"
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "app.shortnut.desktop"
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "Shortnut"
!macroend
